[global]
    monitor = 0
    follow = mouse
    width = 360
    height = 300
    origin = top-right
    offset = 12x12
    scale = 0
    notification_limit = 10

    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 0
    progress_bar_min_width = 120
    progress_bar_max_width = 320
    progress_bar_corner_radius = 4

    indicate_hidden = true
    transparency = 0
    separator_height = 2
    padding = 10
    horizontal_padding = 12
    text_icon_padding = 10
    frame_width = 2
    frame_color = "#88C0D0"
    separator_color = frame
    gap_size = 6
    sort = true

    font = JetBrainsMono Nerd Font 10
    line_height = 3
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    ellipsize = middle
    stack_duplicates = true
    show_indicators = true

    enable_recursive_icon_lookup = true
    icon_position = left
    min_icon_size = 32
    max_icon_size = 64

    history_length = 20
    browser = /usr/bin/xdg-open
    corner_radius = 6
    mouse_left_click = context, close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#2E3440"
    foreground = "#D8DEE9"
    frame_color = "#4C566A"
    timeout = 5

[urgency_normal]
    background = "#2E3440"
    foreground = "#ECEFF4"
    frame_color = "#88C0D0"
    timeout = 5

[urgency_critical]
    background = "#2E3440"
    foreground = "#ECEFF4"
    frame_color = "#BF616A"
    timeout = 0
