{
  "layer": "top",
  "position": "top",
  "height": 40,
  "spacing": 0,

  "modules-left": [
    "hyprland/workspaces",
    "hyprland/window"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "pulseaudio",
    "memory",
    "cpu",
    "tray"
  ],

  "hyprland/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "sort-by": "name",
    "ignore-workspaces": ["^1$"],
    "persistent-workspaces": {
      "DP-3": ["w", "t", "p", "a", "d", "x", "c", "b", "m"]
    }
  },
  "hyprland/window": {
    "format": "{class}",
    "max-length": 50,
    "separate-outputs": true
  },
  "clock": {
    "format": "{:%a %b %d  %H:%M}",
    "tooltip-format": "{:%A, %B %d, %Y\n%H:%M:%S}",
    "interval": 1
  },
  "pulseaudio": {
    "format": "󰕾 {volume}%",
    "format-muted": "󰖁 muted",
    "scroll-step": 5,
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "tooltip-format": "{desc} — {volume}%"
  },
  "memory": {
    "interval": 10,
    "format": "󰍛 {percentage}%",
    "tooltip-format": "RAM: {used:0.1f}G / {total:0.1f}G"
  },
  "cpu": {
    "interval": 10,
    "format": " {usage}%",
    "tooltip-format": "CPU usage: {usage}%"
  },
  "tray": {
    "spacing": 8
  }
}
