{
  "layer": "top",
  "position": "top",
  "height": 34,
  "spacing": 0,
  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["clock"],
  "modules-right": ["group/system"],
  "group/system": {
    "orientation": "horizontal",
    "modules": [
      "pulseaudio", "pulseaudio#mic", "custom/brightness",
      "bluetooth", "network", "battery"
    ]
  },
  "hyprland/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "active-only": false
  },
  "clock": {
    "format": "{:%a %d  %H:%M}",
    "tooltip-format": "{:%A, %B %d, %Y\n%H:%M:%S}",
    "interval": 1
  },
  "pulseaudio": {
    "format": "vol {volume}%",
    "format-muted": "vol muted",
    "scroll-step": 5,
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "tooltip-format": "{desc} — {volume}%"
  },
  "pulseaudio#mic": {
    "format": "{format_source}",
    "format-muted": "{format_source}",
    "format-source": "mic on",
    "format-source-muted": "<span foreground='#bf616a'>mic muted</span>",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
    "on-scroll-up": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SOURCE@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%-",
    "tooltip-format": "Microphone — click to mute; scroll to adjust"
  },
  "custom/brightness": {
    "exec": "python3 ~/.config/waybar/status.py brightness",
    "return-type": "json",
    "format": "{}",
    "interval": 30,
    "on-scroll-up": "python3 ~/.config/waybar/status.py brightness +",
    "on-scroll-down": "python3 ~/.config/waybar/status.py brightness -"
  },
  "battery": {
    "format": "bat {capacity}%",
    "format-charging": "bat {capacity}% charging",
    "format-full": "bat {capacity}% full",
    "tooltip-format": "{timeTo}",
    "interval": 30,
    "states": { "warning": 20, "critical": 10 }
  },
  "bluetooth": {
    "format": "bt",
    "format-connected": "bt",
    "format-disabled": "bt off",
    "format-off": "bt off",
    "format-no-controller": "bt n/a",
    "tooltip-format": "Bluetooth: {status}",
    "tooltip-format-connected": "{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "on-click": "blueman-manager"
  },
  "network": {
    "interface": "wl*",
    "format-wifi": "wifi",
    "format-disconnected": "wifi offline",
    "format-disabled": "wifi off",
    "tooltip-format-wifi": "{essid}\n{ipaddr}\nSignal: {signalStrength}%",
    "tooltip-format-disconnected": "Wi-Fi disconnected",
    "on-click": "nm-connection-editor"
  }
}
